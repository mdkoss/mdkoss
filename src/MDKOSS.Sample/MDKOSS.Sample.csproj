<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MDKOSS.Sample</RootNamespace>
    <AssemblyName>MDKOSS.Sample</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <IncludeMdkPnpPlugin>false</IncludeMdkPnpPlugin>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NLog" Version="6.1.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MDKOSS.Core\MDKOSS.Core.csproj" />
    <ProjectReference Include="..\MDKOSS.Extensions\MDKOSS.Extensions.csproj" />
    <!-- Cef Content views/** 经 ProjectReference 复制到输出 views/，勿再 Link 一遍以免 views\views 嵌套 -->
    <ProjectReference Include="..\MDKOSS.Cef\MDKOSS.Cef.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="configs\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- 仅扩展示例页；核心 HMI 复用 MDKOSS.Cef/views -->
    <None Update="views\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- 扩展示例配置放到 configs/ext，避免默认“第一个 json”误加载 camera/modserver -->
    <None Include="..\MDKOSS.Extensions.Camera\configs\**\*">
      <Link>configs\ext\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\MDKOSS.Extensions.PyScript\configs\**\*">
      <Link>configs\ext\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\MDKOSS.Extensions.ModServer\configs\**\*">
      <Link>configs\ext\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="..\MdkPlugins.targets" />
</Project>
