{
  "projectName": "Sample 扩展示例",
  "startPage": "demo_sample_ext.html",
  "monitoringPrefix": "http://127.0.0.1:5083/",
  "cycleMs": 20,
  "drivers": [
    {
      "id": "drv-motion",
      "type": "sim",
      "enabled": true,
      "parameters": {
        "ip": "127.0.0.1",
        "port": "5000",
        "note": "仿真驱动：扩展示例点动轴",
        "ioBitBase": "0"
      }
    }
  ],
  "devices": [
    {
      "id": "sample-beacon",
      "name": "Sample Beacon",
      "type": "samplebeacon",
      "enabled": true,
      "parameters": {
        "label": "扩展示例信标",
        "note": "SampleExt 自定义设备示例（无板卡依赖）"
      }
    }
  ],
  "platforms": [
    {
      "id": "head-demo",
      "name": "演示轴 XYZ",
      "type": "xyz",
      "driverId": "drv-motion",
      "enabled": true,
      "parameters": {
        "note": "SampleExt MotionTask 点动目标"
      }
    }
  ],
  "tasks": [
    {
      "name": "sample-motion-demo",
      "type": "samplemotion",
      "driverId": "drv-motion",
      "intervalMs": 100,
      "parameters": {
        "platformDeviceId": "head-demo",
        "axisLetter": "X",
        "beaconDeviceId": "sample-beacon",
        "targetPos": "5",
        "jogVelocity": "2",
        "jogTicks": "3",
        "note": "SampleExt MotionTask：enable/move/jog/stop"
      }
    },
    {
      "name": "calib-head-demo",
      "type": "flow",
      "intervalMs": 50,
      "parameters": {
        "calib": "true",
        "displayName": "演示头 XY 偏置",
        "group": "标定",
        "loop": "false",
        "autoStart": "false",
        "flowFile": "configs/flows/calib-head-demo.flow.json",
        "expectedX": "5"
      }
    }
  ],
  "vars": {
    "machine.mode": "AUTO",
    "machine.ready": true
  }
}
