<!--
  Builds optional MDKOSS plugin projects and copies their outputs into $(OutputPath)plugins\
  so MdkExtensionHost.DiscoverAndRegister can load them without host ProjectReferences.
-->
<Project>
  <PropertyGroup>
    <MdkPluginsRoot>$(MSBuildThisFileDirectory)</MdkPluginsRoot>
    <!-- Cef.Sample 等通用宿主可设 false，避免构建/复制 examples/pnp。 -->
    <IncludeMdkPnpPlugin Condition="'$(IncludeMdkPnpPlugin)' == ''">true</IncludeMdkPnpPlugin>
  </PropertyGroup>

  <!-- Hosts load Serial from plugins/ but JIT of SerialDevice needs System.IO.Ports in the default load context. -->
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'@(MdkPluginProject)' == ''">
    <MdkPluginProject Include="$(MdkPluginsRoot)MDKOSS.Drivers.Sim\MDKOSS.Drivers.Sim.csproj" />
    <MdkPluginProject Include="$(MdkPluginsRoot)MDKOSS.Drivers.Gts\MDKOSS.Drivers.Gts.csproj" />
    <MdkPluginProject Include="$(MdkPluginsRoot)MDKOSS.Drivers.Dmc\MDKOSS.Drivers.Dmc.csproj" />
    <MdkPluginProject Include="$(MdkPluginsRoot)MDKOSS.Extensions.Serial\MDKOSS.Extensions.Serial.csproj" />
    <MdkPluginProject Include="$(MdkPluginsRoot)MDKOSS.Extensions.Tcp\MDKOSS.Extensions.Tcp.csproj" />
    <MdkPluginProject Include="$(MdkPluginsRoot)MDKOSS.Extensions.Mysql\MDKOSS.Extensions.Mysql.csproj" />
    <MdkPluginProject Include="$(MdkPluginsRoot)MDKOSS.Extensions.Camera\MDKOSS.Extensions.Camera.csproj" />
    <MdkPluginProject Include="$(MdkPluginsRoot)MDKOSS.Extensions.PyScript\MDKOSS.Extensions.PyScript.csproj" />
    <MdkPluginProject Include="$(MdkPluginsRoot)MDKOSS.Extensions.ModServer\MDKOSS.Extensions.ModServer.csproj" />
    <MdkPluginProject Include="$(MdkPluginsRoot)MDKOSS.Cef.Extensions\MDKOSS.Cef.Extensions.csproj" />
    <MdkPluginProject Include="$(MdkPluginsRoot)..\examples\pnp\MDKOSS.Pnp.csproj" Condition="'$(IncludeMdkPnpPlugin)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <MdkPluginAssembly Include="$(MdkPluginsRoot)MDKOSS.Drivers.Sim\bin\$(Configuration)\$(TargetFramework)\MDKOSS.Drivers.Sim.dll" />
    <MdkPluginAssembly Include="$(MdkPluginsRoot)MDKOSS.Drivers.Gts\bin\$(Configuration)\$(TargetFramework)\MDKOSS.Drivers.Gts.dll" />
    <MdkPluginAssembly Include="$(MdkPluginsRoot)MDKOSS.Drivers.Dmc\bin\$(Configuration)\$(TargetFramework)\MDKOSS.Drivers.Dmc.dll" />
    <MdkPluginAssembly Include="$(MdkPluginsRoot)MDKOSS.Extensions.Serial\bin\$(Configuration)\$(TargetFramework)\MDKOSS.Extensions.Serial.dll" />
    <MdkPluginAssembly Include="$(MdkPluginsRoot)MDKOSS.Extensions.Tcp\bin\$(Configuration)\$(TargetFramework)\MDKOSS.Extensions.Tcp.dll" />
    <MdkPluginAssembly Include="$(MdkPluginsRoot)MDKOSS.Extensions.Mysql\bin\$(Configuration)\$(TargetFramework)\MDKOSS.Extensions.Mysql.dll" />
    <MdkPluginAssembly Include="$(MdkPluginsRoot)MDKOSS.Extensions.Camera\bin\$(Configuration)\$(TargetFramework)\MDKOSS.Extensions.Camera.dll" />
    <MdkPluginAssembly Include="$(MdkPluginsRoot)MDKOSS.Extensions.PyScript\bin\$(Configuration)\$(TargetFramework)\MDKOSS.Extensions.PyScript.dll" />
    <MdkPluginAssembly Include="$(MdkPluginsRoot)MDKOSS.Extensions.ModServer\bin\$(Configuration)\$(TargetFramework)\MDKOSS.Extensions.ModServer.dll" />
    <MdkPluginAssembly Include="$(MdkPluginsRoot)MDKOSS.Cef.Extensions\bin\$(Configuration)\$(TargetFramework)\MDKOSS.Cef.Extensions.dll" />
    <MdkPluginAssembly Include="$(MdkPluginsRoot)..\examples\pnp\bin\$(Configuration)\$(TargetFramework)\MDKOSS.Pnp.dll" Condition="'$(IncludeMdkPnpPlugin)' == 'true'" />
  </ItemGroup>

  <!-- Skip design-time / IntelliSense builds: VS evaluates every host that imports this
       file and would otherwise nested-MSBuild ~9 plugins in parallel per host → OOM. -->
  <Target Name="BuildAndCopyMdkPlugins"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' == 'true' AND '$(SkipMdkPlugins)' != 'true'">
    <PropertyGroup>
      <_HostOutDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(OutputPath)'))</_HostOutDir>
      <MdkPluginsOutputDir>$(_HostOutDir)plugins\</MdkPluginsOutputDir>
    </PropertyGroup>

    <Message Importance="high" Text="Building MDKOSS plugins → $(MdkPluginsOutputDir)" />
    <MSBuild
      Projects="@(MdkPluginProject)"
      Targets="Build"
      BuildInParallel="true"
      Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=" />

    <MakeDir Directories="$(MdkPluginsOutputDir)" />

    <Copy
      SourceFiles="@(MdkPluginAssembly)"
      DestinationFolder="$(MdkPluginsOutputDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('%(MdkPluginAssembly.Identity)')" />

    <!-- Serial / other package dependencies: copy next to the plugin AND the host exe.
         Default ALC (and JIT of SerialDevice.Dispose) looks beside the exe; PluginLoadContext looks in plugins/. -->
    <PropertyGroup>
      <_SerialOutDir>$(MdkPluginsRoot)MDKOSS.Extensions.Serial\bin\$(Configuration)\$(TargetFramework)\</_SerialOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_SerialDeps Include="$(_SerialOutDir)System.IO.Ports.dll" />
      <_SerialDeps Include="$(_SerialOutDir)System.IO.Ports.*.dll" />
      <_SerialDepsJson Include="$(_SerialOutDir)*.deps.json" />
      <_SerialRuntime Include="$(_SerialOutDir)runtimes\win\**\*.*" />
      <_ModServerDeps Include="$(MdkPluginsRoot)MDKOSS.Extensions.ModServer\bin\$(Configuration)\$(TargetFramework)\NModbus.dll" />
      <_ModServerDeps Include="$(MdkPluginsRoot)MDKOSS.Extensions.ModServer\bin\$(Configuration)\$(TargetFramework)\NModbus.*.dll" />
      <_ModServerDepsJson Include="$(MdkPluginsRoot)MDKOSS.Extensions.ModServer\bin\$(Configuration)\$(TargetFramework)\*.deps.json" />
      <_MysqlDeps Include="$(MdkPluginsRoot)MDKOSS.Extensions.Mysql\bin\$(Configuration)\$(TargetFramework)\MySqlConnector.dll" />
      <_MysqlDeps Include="$(MdkPluginsRoot)MDKOSS.Extensions.Mysql\bin\$(Configuration)\$(TargetFramework)\MySqlConnector.*.dll" />
      <_MysqlDepsJson Include="$(MdkPluginsRoot)MDKOSS.Extensions.Mysql\bin\$(Configuration)\$(TargetFramework)\*.deps.json" />
    </ItemGroup>

    <Copy
      SourceFiles="@(_SerialDeps)"
      DestinationFolder="$(MdkPluginsOutputDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('%(_SerialDeps.Identity)')" />

    <Copy
      SourceFiles="@(_SerialDeps)"
      DestinationFolder="$(_HostOutDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('%(_SerialDeps.Identity)')" />

    <Copy
      SourceFiles="@(_SerialDepsJson)"
      DestinationFolder="$(MdkPluginsOutputDir)"
      SkipUnchangedFiles="true"
      Condition="'@(_SerialDepsJson)' != ''" />

    <Copy
      SourceFiles="@(_SerialRuntime)"
      DestinationFiles="@(_SerialRuntime->'$(MdkPluginsOutputDir)runtimes\win\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_SerialRuntime)' != ''" />

    <Copy
      SourceFiles="@(_SerialRuntime)"
      DestinationFiles="@(_SerialRuntime->'$(_HostOutDir)runtimes\win\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_SerialRuntime)' != ''" />

    <Copy
      SourceFiles="@(_ModServerDeps)"
      DestinationFolder="$(MdkPluginsOutputDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('%(_ModServerDeps.Identity)')" />

    <Copy
      SourceFiles="@(_ModServerDepsJson)"
      DestinationFolder="$(MdkPluginsOutputDir)"
      SkipUnchangedFiles="true"
      Condition="'@(_ModServerDepsJson)' != ''" />

    <Copy
      SourceFiles="@(_MysqlDeps)"
      DestinationFolder="$(MdkPluginsOutputDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('%(_MysqlDeps.Identity)')" />

    <Copy
      SourceFiles="@(_MysqlDeps)"
      DestinationFolder="$(_HostOutDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('%(_MysqlDeps.Identity)')" />

    <Copy
      SourceFiles="@(_MysqlDepsJson)"
      DestinationFolder="$(MdkPluginsOutputDir)"
      SkipUnchangedFiles="true"
      Condition="'@(_MysqlDepsJson)' != ''" />

    <!-- HMI 组态页 / 控件脚本落到宿主 views/，供 MonitoringServer 静态资源服务 -->
    <ItemGroup>
      <_CefHmiViews Include="$(MdkPluginsRoot)MDKOSS.Cef.Extensions\views\**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_CefHmiViews)"
      DestinationFiles="@(_CefHmiViews->'$(_HostOutDir)views\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_CefHmiViews)' != ''" />
  </Target>

  <!-- Build copies plugins into OutputPath only; Publish must copy them into PublishDir
       or GitHub release zips ship hosts without Drivers.*/Extensions.* plugins. -->
  <Target Name="CopyMdkPluginsToPublishDir"
          AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(SkipMdkPlugins)' != 'true' AND '$(PublishDir)' != ''">
    <PropertyGroup>
      <_HostOutDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(OutputPath)'))</_HostOutDir>
      <_SrcPlugins>$(_HostOutDir)plugins\</_SrcPlugins>
      <_PubRoot>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</_PubRoot>
      <_PubPlugins>$(_PubRoot)plugins\</_PubPlugins>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(_SrcPlugins)')">
      <_PluginPublishFiles Include="$(_SrcPlugins)**\*.*" />
    </ItemGroup>

    <MakeDir Directories="$(_PubPlugins)" Condition="'@(_PluginPublishFiles)' != ''" />
    <Copy
      SourceFiles="@(_PluginPublishFiles)"
      DestinationFiles="@(_PluginPublishFiles->'$(_PubPlugins)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_PluginPublishFiles)' != ''" />

    <!-- Serial / MySQL deps must sit beside the published host exe (same as Build). -->
    <ItemGroup Condition="Exists('$(_HostOutDir)')">
      <_HostSidePublishDeps Include="$(_HostOutDir)System.IO.Ports.dll" />
      <_HostSidePublishDeps Include="$(_HostOutDir)System.IO.Ports.*.dll" />
      <_HostSidePublishDeps Include="$(_HostOutDir)MySqlConnector.dll" />
      <_HostSidePublishDeps Include="$(_HostOutDir)MySqlConnector.*.dll" />
      <_HostSidePublishRuntime Include="$(_HostOutDir)runtimes\win\**\*.*" />
    </ItemGroup>

    <Copy
      SourceFiles="@(_HostSidePublishDeps)"
      DestinationFolder="$(_PubRoot)"
      SkipUnchangedFiles="true"
      Condition="Exists('%(_HostSidePublishDeps.Identity)')" />

    <Copy
      SourceFiles="@(_HostSidePublishRuntime)"
      DestinationFiles="@(_HostSidePublishRuntime->'$(_PubRoot)runtimes\win\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_HostSidePublishRuntime)' != ''" />

    <ItemGroup>
      <_CefHmiViewsPub Include="$(MdkPluginsRoot)MDKOSS.Cef.Extensions\views\**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_CefHmiViewsPub)"
      DestinationFiles="@(_CefHmiViewsPub->'$(_PubRoot)views\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_CefHmiViewsPub)' != ''" />
  </Target>
</Project>
