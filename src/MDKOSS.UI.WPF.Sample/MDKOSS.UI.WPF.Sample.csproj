<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>MDKOSS.UI.WPF.Sample</RootNamespace>
    <AssemblyName>MDKOSS.UI.WPF.Sample</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <StartupObject>MDKOSS.UI.WPF.Sample.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <IncludeMdkPnpPlugin>false</IncludeMdkPnpPlugin>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NLog" Version="6.1.2" />
    <PackageReference Include="Prism.DryIoc" Version="9.0.537" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.Net.Http" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MDKOSS.Core\MDKOSS.Core.csproj" />
    <ProjectReference Include="..\MDKOSS.Extensions\MDKOSS.Extensions.csproj" />
    <ProjectReference Include="..\MDKOSS.UI.WPF\MDKOSS.UI.WPF.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\MDKOSS.Sample\SampleExt\SampleBeaconDevice.cs" Link="SampleExt\SampleBeaconDevice.cs" />
    <Compile Include="..\MDKOSS.Sample\SampleExt\SampleExtApiModule.cs" Link="SampleExt\SampleExtApiModule.cs" />
    <Compile Include="..\MDKOSS.Sample\SampleExt\SampleExtExtension.cs" Link="SampleExt\SampleExtExtension.cs" />
    <Compile Include="..\MDKOSS.Sample\SampleExt\SampleMotionDemoTask.cs" Link="SampleExt\SampleMotionDemoTask.cs" />
    <Compile Include="..\MDKOSS.Sample\SampleExt\SampleDingTalkPublisher.cs" Link="SampleExt\SampleDingTalkPublisher.cs" />
    <Compile Include="..\MDKOSS.Sample\SampleExt\SampleRunScreenshot.cs" Link="SampleExt\SampleRunScreenshot.cs" />
    <Compile Include="..\MDKOSS.Sample\SampleExt\SampleExtViewPages.cs" Link="SampleExt\SampleExtViewPages.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="configs\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <Import Project="..\MdkPlugins.targets" />
</Project>
