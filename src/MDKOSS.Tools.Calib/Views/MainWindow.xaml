<Window x:Class="MDKOSS.Tools.Calib.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MDKOSS.Tools.Calib — 标定工具"
        Height="780" Width="1280"
        MinHeight="560" MinWidth="980"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="4,2">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="打开配置…(_O)" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
        <MenuItem Header="保存配置(_S)" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
        <Separator/>
        <MenuItem Header="退出" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="标定(_C)">
        <MenuItem Header="运行" Command="{Binding RunCommand}"/>
        <MenuItem Header="停止" Command="{Binding StopCommand}"/>
        <MenuItem Header="应用参数" Command="{Binding ApplyParamsCommand}"/>
        <Separator/>
        <MenuItem Header="编辑流程…" Command="{Binding EditFlowCommand}"/>
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,0,1" Padding="10,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="打开配置" Command="{Binding OpenCommand}"/>
          <Button Content="保存" Command="{Binding SaveCommand}"/>
          <Button Content="应用参数" Command="{Binding ApplyParamsCommand}"/>
          <Button Content="编辑流程" Command="{Binding EditFlowCommand}"/>
          <Button Content="运行" Command="{Binding RunCommand}"
                  Background="#D8F3E6" FontWeight="SemiBold"/>
          <Button Content="停止" Command="{Binding StopCommand}"
                  Background="#FDE8E8" Margin="0"/>
        </StackPanel>
        <TextBlock Text="{Binding SelectedSummary}" VerticalAlignment="Center"
                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
      </DockPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
               BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,1,0,0" Padding="8,4">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock>
          <Run Text="状态 "/><Run Text="{Binding RunState, Mode=OneWay}" FontWeight="SemiBold"/>
        </TextBlock>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock Text="{Binding SettingPath}" Foreground="{StaticResource MutedBrush}"/>
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="标定项目" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoftBrush}"
                          CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                  </Border>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="标定参数" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <DataGrid ItemsSource="{Binding Parameters}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="参数" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
              <DataGridTextColumn Header="值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

      <Grid Grid.Column="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="4" Padding="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="标定执行结果" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DataGrid ItemsSource="{Binding Results}" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="项" Binding="{Binding Key}" Width="140"/>
                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="4" Padding="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="标定执行流程" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding Logs}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Display}" FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI" FontSize="12"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
