<Window x:Class="MDKOSS.Tools.Calib.Views.FlowEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑标定流程"
        Height="640" Width="920"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13">
  <DockPanel Margin="10">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock x:Name="ValidationText" DockPanel.Dock="Left" VerticalAlignment="Center"
                 Foreground="{StaticResource MutedBrush}" Text="校验"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" IsCancel="True" Width="80"/>
        <Button Content="确定" Width="80" Margin="0" IsDefault="True" Click="Ok_Click"/>
      </StackPanel>
    </DockPanel>

    <TabControl x:Name="Tab">
      <TabItem Header="节点">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="添加节点" Click="AddNode_Click"/>
            <Button Content="删除" Click="DeleteNode_Click"/>
            <Button Content="上移" Click="MoveUp_Click"/>
            <Button Content="下移" Click="MoveDown_Click"/>
            <Button Content="预览 JSON" Click="Preview_Click" Margin="0"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                     Text="线性顺序即执行顺序。if/while 请用 JSON 页签编辑端口。"/>
          <DataGrid x:Name="NodeList" AutoGenerateColumns="False" CanUserAddRows="False"
                    HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Id" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
              <DataGridComboBoxColumn Header="Kind" Width="200"
                                      SelectedItemBinding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}">
                <DataGridComboBoxColumn.ElementStyle>
                  <Style TargetType="ComboBox">
                    <Setter Property="ItemsSource" Value="{Binding DataContext.KindChoices, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Setter Property="IsReadOnly" Value="True"/>
                  </Style>
                </DataGridComboBoxColumn.ElementStyle>
                <DataGridComboBoxColumn.EditingElementStyle>
                  <Style TargetType="ComboBox">
                    <Setter Property="ItemsSource" Value="{Binding DataContext.KindChoices, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Setter Property="IsEditable" Value="True"/>
                  </Style>
                </DataGridComboBoxColumn.EditingElementStyle>
              </DataGridComboBoxColumn>
              <DataGridTextColumn Header="Props (JSON)" Binding="{Binding PropsText, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="JSON">
        <DockPanel Margin="8">
          <Button DockPanel.Dock="Top" Content="从 JSON 载入节点列表" Click="FromJson_Click"
                  HorizontalAlignment="Left" Margin="0,0,0,8"/>
          <TextBox x:Name="JsonBox" AcceptsReturn="True" TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas, Cascadia Mono" FontSize="12"/>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
