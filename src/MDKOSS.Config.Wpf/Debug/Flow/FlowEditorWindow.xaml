<Window x:Class="MDKOSS.Config.Wpf.Debug.Flow.FlowEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flow 流程编辑器"
        Height="820" Width="1280"
        MinHeight="640" MinWidth="1000"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="8">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="上移" Click="MoveUp_Click" ToolTip="Ctrl+Up"/>
        <Button Content="下移" Click="MoveDown_Click" ToolTip="Ctrl+Down"/>
        <Button Content="重新排布" Click="Relayout_Click"/>
        <Button Content="校验" Click="Validate_Click"/>
        <Button Content="删除节点" Click="DeleteNode_Click"/>
        <Button Content="应用到工作区" Click="Apply_Click"
                Background="{StaticResource AccentBrush}" Foreground="White" Padding="12,4"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Task" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
        <ComboBox x:Name="TaskCombo" Width="260" SelectionChanged="TaskCombo_SelectionChanged"/>
        <TextBlock Text="IntervalMs" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="IntervalBox" Width="70" Text="100"/>
        <TextBlock x:Name="HintText" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                   Foreground="{StaticResource MutedBrush}"
                   Text="复合块：选 if→进入 Then/Else；选 while→进入 Body；工具箱插入到当前插槽；折叠整块"/>
      </StackPanel>
    </DockPanel>

    <Grid DockPanel.Dock="Bottom" Height="140" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="校验" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
          <TextBox Text="{Binding ValidationText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="flowJson 预览" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
          <TextBox Text="{Binding JsonPreview, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   BorderThickness="0" Background="Transparent"/>
        </DockPanel>
      </Border>
    </Grid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <!-- Toolbox -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="工具箱（插入）" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
            <Button Content="setVar" Tag="setVar" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="declareVar" Tag="declareVar" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="if" Tag="if" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="while" Tag="while" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="delay" Tag="delay" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="call" Tag="call" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="op.writeIo" Tag="op.writeIo" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="op.deviceAction" Tag="op.deviceAction" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="op.log" Tag="op.log" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <TextBlock Text="Motion" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,6"/>
            <Button Content="axisMoveTo" Tag="motion.axisMoveTo" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="axisEnable" Tag="motion.axisEnable" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="platformSetMotion" Tag="motion.platformSetMotion" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="platformStart" Tag="motion.platformStart" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="platformStop" Tag="motion.platformStop" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="platformAxisMoveTo" Tag="motion.platformAxisMoveTo" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="gpioWrite" Tag="motion.gpioWrite" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="gpioRead" Tag="motion.gpioRead" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="deviceSnapshot" Tag="motion.deviceSnapshot" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="ensureDriver" Tag="motion.ensureDriver" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="setParam" Tag="motion.setParam" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="getParam" Tag="motion.getParam" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="setTaskVar" Tag="motion.setTaskVar" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="setGlobalVar" Tag="motion.setGlobalVar" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Canvas -->
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4">
        <ScrollViewer x:Name="GraphScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Canvas x:Name="GraphCanvas" Width="900" Height="1600" Background="#FAFBFC"
                  MouseLeftButtonDown="Canvas_MouseLeftButtonDown"/>
        </ScrollViewer>
      </Border>

      <!-- Properties -->
      <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="选中节点" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding FocusLabel}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,8">
              <Button Content="根序列" Click="FocusRoot_Click" Margin="0,0,4,4" Padding="8,2"/>
              <Button Content="Then" Click="FocusThen_Click" Margin="0,0,4,4" Padding="8,2"
                      IsEnabled="{Binding SelectedIsIf}"/>
              <Button Content="Else" Click="FocusElse_Click" Margin="0,0,4,4" Padding="8,2"
                      IsEnabled="{Binding SelectedIsIf}"/>
              <Button Content="Body" Click="FocusBody_Click" Margin="0,0,4,4" Padding="8,2"
                      IsEnabled="{Binding SelectedIsWhile}"/>
              <Button Content="父级" Click="FocusParent_Click" Margin="0,0,4,4" Padding="8,2"/>
              <Button Content="折叠/展开" Click="ToggleCollapse_Click" Margin="0,0,4,4" Padding="8,2"
                      IsEnabled="{Binding SelectedIsComposite}"/>
            </WrapPanel>
            <TextBlock Text="Id" Foreground="{StaticResource MutedBrush}"/>
            <TextBox Text="{Binding Selected.Id, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,6"/>
            <TextBlock Text="Kind" Foreground="{StaticResource MutedBrush}"/>
            <TextBox Text="{Binding Selected.Kind, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,6"/>
            <TextBlock Text="Slot" Foreground="{StaticResource MutedBrush}"/>
            <TextBox Text="{Binding Selected.Slot, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,6"/>
            <TextBlock Text="Props" FontWeight="SemiBold" Margin="0,4,0,4"/>
            <DataGrid ItemsSource="{Binding Selected.Props}" AutoGenerateColumns="False"
                      CanUserAddRows="True" CanUserDeleteRows="True" Height="160"
                      HeadersVisibility="Column" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1"
                      CellEditEnding="PropGrid_CellEditEnding">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="复合块" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="if/while 为容器：子节点带 parentId+slot；边由树自动生成。绿色框=当前插入插槽。"
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>

            <TextBlock Text="变量声明" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{StaticResource AccentBrush}"/>
            <DockPanel Margin="0,0,0,4">
              <Button DockPanel.Dock="Right" Content="+ 变量" Click="AddVar_Click" Padding="8,2"/>
            </DockPanel>
            <DataGrid ItemsSource="{Binding Variables}" AutoGenerateColumns="False" Height="100"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1"
                      CellEditEnding="MetaGrid_CellEditEnding">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <DataGridTextColumn Header="Init" Binding="{Binding Init, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="函数" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{StaticResource AccentBrush}"/>
            <DataGrid ItemsSource="{Binding Functions}" AutoGenerateColumns="False" Height="80"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1"
                      CellEditEnding="MetaGrid_CellEditEnding">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="EntryNodeId" Binding="{Binding EntryNodeId, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
