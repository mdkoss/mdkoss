<Window x:Class="MDKOSS.Config.Wpf.Debug.Flow.FlowEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:flow="clr-namespace:MDKOSS.Config.Wpf.Debug.Flow"
        Title="Flow 流程编辑器"
        Height="820" Width="1280"
        MinHeight="640" MinWidth="1000"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="8">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="校验" Click="Validate_Click"/>
        <Button Content="删除节点" Click="DeleteNode_Click"/>
        <Button Content="应用到工作区" Click="Apply_Click"
                Background="{StaticResource AccentBrush}" Foreground="White" Padding="12,4"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Task" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
        <ComboBox x:Name="TaskCombo" Width="260" SelectionChanged="TaskCombo_SelectionChanged"/>
        <TextBlock Text="IntervalMs" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="IntervalBox" Width="70" Text="100"/>
        <TextBlock x:Name="HintText" Margin="16,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource MutedBrush}" Text="左键拖节点；先点输出端口再点目标节点输入以连线"/>
      </StackPanel>
    </DockPanel>

    <Grid DockPanel.Dock="Bottom" Height="140" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="校验" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
          <TextBox Text="{Binding ValidationText}" IsReadOnly="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="flowJson 预览" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
          <TextBox Text="{Binding JsonPreview}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   BorderThickness="0" Background="Transparent"/>
        </DockPanel>
      </Border>
    </Grid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <!-- Toolbox -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="工具箱" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
            <Button Content="start" Tag="start" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="end" Tag="end" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="declareVar" Tag="declareVar" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="setVar" Tag="setVar" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="if" Tag="if" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="while" Tag="while" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="delay" Tag="delay" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="call" Tag="call" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="op.writeIo" Tag="op.writeIo" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="op.deviceAction" Tag="op.deviceAction" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="op.log" Tag="op.log" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Canvas -->
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Canvas x:Name="GraphCanvas" Width="2400" Height="1600" Background="#FAFBFC"
                  MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                  MouseMove="Canvas_MouseMove"
                  MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/>
        </ScrollViewer>
      </Border>

      <!-- Properties -->
      <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="选中节点" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="Id" Foreground="{StaticResource MutedBrush}"/>
            <TextBox Text="{Binding Selected.Id, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,6"/>
            <TextBlock Text="Kind" Foreground="{StaticResource MutedBrush}"/>
            <TextBox Text="{Binding Selected.Kind, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,6"/>
            <TextBlock Text="Props" FontWeight="SemiBold" Margin="0,4,0,4"/>
            <DataGrid ItemsSource="{Binding Selected.Props}" AutoGenerateColumns="False"
                      CanUserAddRows="True" CanUserDeleteRows="True" Height="140"
                      HeadersVisibility="Column" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1"
                      CellEditEnding="PropGrid_CellEditEnding">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="输出端口 → 连线" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{StaticResource AccentBrush}"/>
            <ItemsControl x:Name="PortList" ItemsSource="{Binding Selected.OutputPorts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding}" Margin="0,0,0,4" HorizontalAlignment="Stretch"
                          Click="PortButton_Click" Tag="{Binding}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="LinkHint" Text="" Foreground="#B54708" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <TextBlock Text="变量声明" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{StaticResource AccentBrush}"/>
            <DockPanel Margin="0,0,0,4">
              <Button DockPanel.Dock="Right" Content="+ 变量" Click="AddVar_Click" Padding="8,2"/>
            </DockPanel>
            <DataGrid ItemsSource="{Binding Variables}" AutoGenerateColumns="False" Height="100"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1"
                      CellEditEnding="MetaGrid_CellEditEnding">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <DataGridTextColumn Header="Init" Binding="{Binding Init, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="函数" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{StaticResource AccentBrush}"/>
            <DataGrid ItemsSource="{Binding Functions}" AutoGenerateColumns="False" Height="80"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1"
                      CellEditEnding="MetaGrid_CellEditEnding">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="EntryNodeId" Binding="{Binding EntryNodeId, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
