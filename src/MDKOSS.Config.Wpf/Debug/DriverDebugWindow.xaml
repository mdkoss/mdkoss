<Window x:Class="MDKOSS.Config.Wpf.Debug.DriverDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Driver 调试"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="860"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="10">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="BtnConnect" Content="连接" Click="Connect_Click" Padding="12,4"/>
        <Button x:Name="BtnDisconnect" Content="断开" Click="Disconnect_Click" Padding="12,4" IsEnabled="False"/>
        <Button Content="刷新状态" Click="Refresh_Click" Padding="12,4"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Driver" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
        <ComboBox x:Name="DriverCombo" Width="220" SelectionChanged="DriverCombo_SelectionChanged"/>
        <TextBlock x:Name="ConnBadge" Text="未连接" Margin="16,0,0,0" VerticalAlignment="Center"
                   FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
    </DockPanel>

    <TextBox x:Name="LogBox" DockPanel.Dock="Bottom" Height="120" Margin="0,10,0,0"
             IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
             BorderBrush="{StaticResource BorderBrushKey}"/>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: identity / params / config path -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="驱动信息" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="Id" Foreground="{StaticResource MutedBrush}"/>
            <TextBox x:Name="IdBox" IsReadOnly="True" Margin="0,0,0,8"/>
            <TextBlock Text="Type" Foreground="{StaticResource MutedBrush}"/>
            <TextBox x:Name="TypeBox" IsReadOnly="True" Margin="0,0,0,8"/>
            <TextBlock Text="Enabled" Foreground="{StaticResource MutedBrush}"/>
            <TextBox x:Name="EnabledBox" IsReadOnly="True" Margin="0,0,0,8"/>
            <TextBlock Text="配置文件路径 (setting DocumentPath)" Foreground="{StaticResource MutedBrush}"/>
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseConfig_Click" Padding="8,3" Margin="6,0,0,0"/>
              <TextBox x:Name="SettingPathBox" IsReadOnly="True"/>
            </DockPanel>
            <TextBlock Text="驱动参数中的配置路径键" Foreground="{StaticResource MutedBrush}"/>
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseDriverCfg_Click" Padding="8,3" Margin="6,0,0,0"/>
              <ComboBox x:Name="CfgKeyCombo" Width="120" DockPanel.Dock="Left" Margin="0,0,6,0"
                        SelectionChanged="CfgKeyCombo_SelectionChanged"/>
              <TextBox x:Name="DriverCfgPathBox"/>
            </DockPanel>
            <TextBlock Text="Parameters" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,4"/>
            <DataGrid x:Name="ParamGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" MinHeight="160" MaxHeight="260"
                      BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1"
                      IsReadOnly="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
              </DataGrid.Columns>
            </DataGrid>
            <Button Content="应用参数到连接副本" Click="ApplyParams_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/>
            <TextBlock Text="说明：参数修改仅作用于本调试会话的驱动副本，不会写回配置文件。写回请在主界面属性面板操作。"
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" FontSize="11"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Right: IO debug -->
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="IO 调试" FontWeight="SemiBold"
                     Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Group" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="IoGroupBox" Width="60" Text="0" Margin="0,0,12,0"/>
            <Button Content="读 DI" Click="ReadDi_Click"/>
            <Button Content="读 DO" Click="ReadDo_Click"/>
            <Button Content="写 DO 字" Click="WriteDo_Click"/>
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
              <TextBlock DockPanel.Dock="Top" Text="DI 位" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <DataGrid x:Name="DiGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                        HeadersVisibility="Column" IsReadOnly="True"
                        BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Bit" Binding="{Binding Label}" Width="60"/>
                  <DataGridCheckBoxColumn Header="On" Binding="{Binding Value}" Width="50" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="2">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="写选中位" Click="WriteDoBit_Click" Padding="8,2"/>
                <TextBlock Text="DO 位（可勾选后写字/写位）" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <DataGrid x:Name="DoGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                        HeadersVisibility="Column"
                        BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Bit" Binding="{Binding Label}" Width="60" IsReadOnly="True"/>
                  <DataGridCheckBoxColumn Header="On" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
