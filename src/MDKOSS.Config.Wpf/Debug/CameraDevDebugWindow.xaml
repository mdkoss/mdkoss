<Window x:Class="MDKOSS.Config.Wpf.Debug.CameraDevDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CameraDev 调试"
        Height="640" Width="860"
        MinHeight="480" MinWidth="700"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="10">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="BtnOpen" Content="打开" Click="Open_Click"/>
        <Button x:Name="BtnClose" Content="关闭" Click="CloseCam_Click" IsEnabled="False"/>
        <Button Content="刷新状态" Click="Refresh_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Camera" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
        <ComboBox x:Name="CameraCombo" Width="300" SelectionChanged="CameraCombo_SelectionChanged"/>
        <TextBlock x:Name="TypeBadge" Text="type=-" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
        <TextBlock x:Name="StateBadge" Text="Closed" Margin="16,0,0,0" VerticalAlignment="Center"
                   FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
    </DockPanel>

    <TextBox x:Name="LogBox" DockPanel.Dock="Bottom" Height="120" Margin="0,10,0,0"
             IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
             BorderBrush="{StaticResource BorderBrushKey}"/>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="1.1*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="12">
        <StackPanel>
          <TextBlock Text="采集控制" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
          <TextBlock Text="Recipe" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
          <TextBox x:Name="RecipeBox" Text="default" Margin="0,0,0,12"/>
          <Button Content="采集图片 / TriggerCapture" Click="Capture_Click" Padding="12,8" HorizontalAlignment="Stretch"
                  Background="{StaticResource AccentBrush}" Foreground="White" Margin="0,0,0,12"/>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11"
                     Text="· cameradev：打开=连接 Driver 并 Start 设备；采集=CameraDevDevice.TriggerCapture&#10;· extcamera：打开/关闭/采集走 ExtCameraDevice（Open/Close/TriggerCapture）或 DeviceActionRegistry"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="状态 / 最近结果" FontWeight="SemiBold"
                     Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
          <TextBox x:Name="StatusBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                   BorderThickness="0" Background="Transparent"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
