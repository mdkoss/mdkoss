<Window x:Class="MDKOSS.Config.Wpf.Debug.AxisDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Axis 调试"
        Height="700" Width="920"
        MinHeight="560" MinWidth="760"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel Margin="10">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="BtnConnect" Content="连接" Click="Connect_Click"/>
        <Button x:Name="BtnDisconnect" Content="断开" Click="Disconnect_Click" IsEnabled="False"/>
        <Button Content="刷新状态" Click="Refresh_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Axis" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
        <ComboBox x:Name="AxisCombo" Width="240" SelectionChanged="AxisCombo_SelectionChanged"/>
        <TextBlock Text="轴号" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="AxisNoBox" Width="48" Text="0"/>
        <TextBlock x:Name="ConnBadge" Text="未连接" Margin="16,0,0,0" VerticalAlignment="Center"
                   FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
    </DockPanel>

    <TextBox x:Name="LogBox" DockPanel.Dock="Bottom" Height="110" Margin="0,10,0,0"
             IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
             BorderBrush="{StaticResource BorderBrushKey}"/>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Status -->
      <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="12">
        <StackPanel>
          <TextBlock Text="状态" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
          <UniformGrid Columns="4">
            <StackPanel Margin="0,0,8,6">
              <TextBlock Text="使能" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock x:Name="StEnabled" Text="-" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,6">
              <TextBlock Text="Status Word" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock x:Name="StStatus" Text="-" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,6">
              <TextBlock Text="指令位置" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock x:Name="StPrfPos" Text="-" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,6">
              <TextBlock Text="编码器位置" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock x:Name="StEncPos" Text="-" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="速度" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock x:Name="StVel" Text="-" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Driver" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock x:Name="StDriver" Text="-" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
              <Button Content="使能" Click="Enable_Click"/>
              <Button Content="去使能" Click="Disable_Click"/>
              <Button Content="停止 (Esc)" Click="Stop_Click" ToolTip="Esc 亦可急停"/>
            </StackPanel>
          </UniformGrid>
          <TextBlock Text="轴状态位" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
          <WrapPanel x:Name="FlagPanel"/>
        </StackPanel>
      </Border>

      <!-- Motion tests -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
                BorderThickness="1" CornerRadius="4" Padding="12">
          <StackPanel>
            <TextBlock Text="运动参数" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="速度" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
              <TextBox Grid.Row="0" Grid.Column="1" x:Name="VelBox" Text="100" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="1" Text="加速度" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
              <TextBox Grid.Row="1" Grid.Column="1" x:Name="AccBox" Text="500" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="2" Text="减速度" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
              <TextBox Grid.Row="2" Grid.Column="1" x:Name="DecBox" Text="500" Margin="0,0,0,6"/>
              <TextBlock Grid.Row="3" Text="目标位置" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
              <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="填入当前" Click="FillPos_Click" Padding="8,2" Margin="6,0,0,0"
                        ToolTip="用当前指令位置填入目标"/>
                <TextBox x:Name="PosBox" Text="1000"/>
              </DockPanel>
              <TextBlock Grid.Row="4" Text="回零模式" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
              <TextBox Grid.Row="4" Grid.Column="1" x:Name="HomeModeBox" Text="0"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
                BorderThickness="1" CornerRadius="4" Padding="12">
          <StackPanel>
            <TextBlock Text="测试动作" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
            <Button Content="回原点 (Home)" Click="Home_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="点动 −" PreviewMouseLeftButtonDown="JogNeg_Down" PreviewMouseLeftButtonUp="Jog_Up"
                      LostMouseCapture="Jog_Up" Width="100"/>
              <Button Content="点动 +" PreviewMouseLeftButtonDown="JogPos_Down" PreviewMouseLeftButtonUp="Jog_Up"
                      LostMouseCapture="Jog_Up" Width="100"/>
              <TextBlock Text="按住点动，松开停止" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </StackPanel>
            <Button Content="速度移动 (Jog 持续)" Click="VelMove_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                    ToolTip="按当前速度参数启动连续运动，需点「停止」结束"/>
            <Button Content="位置移动 (Trap)" Click="PosMove_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       Text="点动/速度移动 → IDriver.MoveAxisJog；位置移动 → MoveAxisTrap；回原点 → MoveAxisHome。轴号默认取设备 parameters.axis。"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
