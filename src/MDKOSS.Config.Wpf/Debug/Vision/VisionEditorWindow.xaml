<Window x:Class="MDKOSS.Config.Wpf.Debug.Vision.VisionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="视觉流程编辑器"
        Height="860" Width="1360"
        MinHeight="680" MinWidth="1100"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="8">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="上移" Click="MoveUp_Click" ToolTip="Ctrl+Up"/>
        <Button Content="下移" Click="MoveDown_Click" ToolTip="Ctrl+Down"/>
        <Button Content="重新排布" Click="Relayout_Click"/>
        <Button Content="载入预览图…" Click="LoadPreview_Click"/>
        <Button Content="试运行…" Click="TryRun_Click"/>
        <Button Content="校验" Click="Validate_Click"/>
        <Button Content="删除节点" Click="DeleteNode_Click"/>
        <Button Content="应用到工作区" Click="Apply_Click"
                Background="{StaticResource AccentBrush}" Foreground="White" Padding="12,4"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Vision" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
        <ComboBox x:Name="VisionCombo" Width="220" SelectionChanged="VisionCombo_SelectionChanged"/>
        <TextBlock Text="Camera" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource MutedBrush}"/>
        <TextBox Width="120" Text="{Binding CameraDeviceId, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="算法" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="AlgorithmCombo" Width="110" SelectionChanged="AlgorithmCombo_SelectionChanged"/>
        <TextBlock x:Name="HintText" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                   Foreground="{StaticResource MutedBrush}"
                   Text="试运行后点选节点可查看该步输入图/输出图/变量；效果图上可拖拽 ROI"/>
      </StackPanel>
    </DockPanel>

    <Grid DockPanel.Dock="Bottom" Height="220" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="1.4*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="校验 / 运行日志" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
          <TextBox x:Name="LogBox" Text="{Binding ValidationText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <TextBlock Text="运行结果效果图 / ROI" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock x:Name="RoiHintText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                       Text="拖拽绘制或移动 ROI"/>
          </DockPanel>
          <Border Background="#111827" CornerRadius="2" ClipToBounds="True">
            <Grid x:Name="PreviewHost" Background="Transparent"
                  MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                  MouseMove="Preview_MouseMove"
                  MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                  MouseLeave="Preview_MouseLeave"
                  SizeChanged="PreviewHost_SizeChanged">
              <Image x:Name="ResultImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsHitTestVisible="False"/>
              <Canvas x:Name="RoiOverlay" IsHitTestVisible="False">
                <Rectangle x:Name="RoiRectVisual" Stroke="#22C55E" StrokeThickness="2"
                           Fill="#3322C55E" Visibility="Collapsed"/>
              </Canvas>
              <TextBlock x:Name="PreviewEmptyHint" Text="试运行或载入预览图后在此显示效果图"
                         Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextWrapping="Wrap" Margin="16" TextAlignment="Center"/>
            </Grid>
          </Border>
        </DockPanel>
      </Border>
      <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="pipelineJson 预览" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
          <TextBox Text="{Binding JsonPreview, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   BorderThickness="0" Background="Transparent"/>
        </DockPanel>
      </Border>
    </Grid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="280"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="预处理" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
            <Button Content="loadImage" Tag="vision.loadImage" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="toGray" Tag="vision.toGray" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="threshold" Tag="vision.threshold" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="blur" Tag="vision.blur" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="morphology" Tag="vision.morphology" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="roi" Tag="vision.roi" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <TextBlock Text="定位 / 识别" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,6"/>
            <Button Content="templateMatch" Tag="vision.templateMatch" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="findContours" Tag="vision.findContours" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="findCircles" Tag="vision.findCircles" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <Button Content="findLines" Tag="vision.findLines" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
            <TextBlock Text="输出" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,6"/>
            <Button Content="outputPose" Tag="vision.outputPose" Click="AddNode_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4">
        <ScrollViewer x:Name="GraphScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Canvas x:Name="GraphCanvas" Width="900" Height="1600" Background="#FAFBFC"
                  MouseLeftButtonDown="Canvas_MouseLeftButtonDown"/>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="选中节点" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="Id" Foreground="{StaticResource MutedBrush}"/>
            <TextBox Text="{Binding Selected.Id, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,6"/>
            <TextBlock Text="Kind" Foreground="{StaticResource MutedBrush}"/>
            <TextBox Text="{Binding Selected.Kind, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,6"/>
            <TextBlock Text="Props" FontWeight="SemiBold" Margin="0,4,0,4"/>
            <DataGrid ItemsSource="{Binding Selected.Props}" AutoGenerateColumns="False"
                      CanUserAddRows="True" CanUserDeleteRows="True" Height="280"
                      HeadersVisibility="Column" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1"
                      CellEditEnding="PropGrid_CellEditEnding">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="试运行中间结果" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="{Binding SelectedTraceSummary}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="输入图" Click="ShowNodeInput_Click" Margin="0,0,8,0" Padding="10,4"/>
              <Button Content="输出图" Click="ShowNodeOutput_Click" Padding="10,4"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
