{
  "projectName": "检测上下料机",
  "cycleMs": 20,
  "monitoringPrefix": "http://127.0.0.1:5080/",
  "startPage": "index.html",
  "drivers": [
    {
      "id": "drv-m1",
      "name": "M1 运动卡",
      "type": "sim",
      "enabled": true,
      "parameters": {
        "ip": "127.0.0.1",
        "port": "5000",
        "card": "0",
        "model": "VirtualCard",
        "note": "M1 运动卡 VirtualCard",
        "ioBitBase": "0"
      }
    },
    {
      "id": "drv-io1",
      "name": "IO1 卡",
      "type": "sim",
      "enabled": true,
      "parameters": {
        "ip": "127.0.0.1",
        "port": "5001",
        "card": "0",
        "model": "VirtualCard",
        "note": "IO1 IO 卡 VirtualCard",
        "ioBitBase": "0"
      }
    },
    {
      "id": "drv-vio",
      "name": "VIO 虚拟卡",
      "type": "vio",
      "enabled": true,
      "parameters": {
        "inBits": "128",
        "outBits": "128",
        "model": "VirtualCard",
        "note": "VIO 128bit DI/DO"
      }
    }
  ],
  "devices": [
    {
      "id": "gpio-main",
      "name": "整机 GPIO",
      "type": "gpio",
      "enabled": true,
      "parameters": {
        "in.DiEstopButton": "drv-m1|di.gpi.bit.0|急停",
        "in.DiStartButton": "drv-m1|di.gpi.bit.1|启动按钮",
        "in.DiStopButton": "drv-m1|di.gpi.bit.2|停止按钮",
        "in.DiResetButton": "drv-m1|di.gpi.bit.3|复位按钮",
        "in.DiSafeDoor1Button": "drv-m1|di.gpi.bit.4|安全门1",
        "in.DiSafeDoor2Button": "drv-m1|di.gpi.bit.5|安全门2",
        "in.DiSafeDoor3Button": "drv-m1|di.gpi.bit.6|安全门3",
        "in.DiSafeDoor4Button": "drv-m1|di.gpi.bit.7|安全门4",
        "in.DiSafeDoor5Button": "drv-m1|di.gpi.bit.8|安全门5",
        "in.DiFrontCy0": "drv-m1|di.gpi.bit.10|前定位气缸原点",
        "in.DiFrontCy1": "drv-m1|di.gpi.bit.11|前定位气缸动点",
        "in.DiBackCy0": "drv-m1|di.gpi.bit.12|后定位气缸原点",
        "in.DiBackCy1": "drv-m1|di.gpi.bit.13|后定位气缸动点",
        "out.DOButtonGreen": "drv-m1|do.gpo.bit.0|启动按钮灯",
        "out.DOButtonRed": "drv-m1|do.gpo.bit.1|停止按钮灯",
        "out.DOButtonYellow": "drv-m1|do.gpo.bit.2|复位按钮灯",
        "out.DOLightGreen": "drv-m1|do.gpo.bit.3|绿灯",
        "out.DOLightYellow": "drv-m1|do.gpo.bit.4|黄灯",
        "out.DOLightRed": "drv-m1|do.gpo.bit.5|红灯",
        "out.DOBuzzer": "drv-m1|do.gpo.bit.6|蜂鸣器",
        "out.DOFrontCy": "drv-m1|do.gpo.bit.8|前定位气缸动作",
        "out.DOBackCy": "drv-m1|do.gpo.bit.9|后定位气缸动作",
        "out.DOLeftCy": "drv-m1|do.gpo.bit.10|左定位气缸动作",
        "out.DORightCy": "drv-m1|do.gpo.bit.11|右定位气缸动作",
        "in.DiLeftCy0": "drv-io1|di.gpi.bit.0|lcy0",
        "in.DiLeftCy1": "drv-io1|di.gpi.bit.1|lcy1",
        "in.DiRightCy0": "drv-io1|di.gpi.bit.2|rcy0",
        "in.DiRightCy1": "drv-io1|di.gpi.bit.3|rcy1",
        "in.DiSensor1": "drv-io1|di.gpi.bit.4|sensor1",
        "in.DiSensor2": "drv-io1|di.gpi.bit.5|sensor2",
        "in.DiSensor3": "drv-io1|di.gpi.bit.6|sensor3",
        "in.DiSafeCurtain": "drv-io1|di.gpi.bit.7|sc",
        "in.DiAirPressure": "drv-io1|di.gpi.bit.8|ap",
        "in.DiStart1": "drv-io1|di.gpi.bit.9|Start1",
        "in.DiStart2": "drv-io1|di.gpi.bit.10|Start2",
        "in.DiVaccum1": "drv-io1|di.gpi.bit.11|Vaccum1",
        "in.DiVaccum2": "drv-io1|di.gpi.bit.12|Vaccum2",
        "out.DOLamp": "drv-io1|do.gpo.bit.0|灯",
        "out.DOVaccum1": "drv-io1|do.gpo.bit.1|真空1",
        "out.DOVaccum2": "drv-io1|do.gpo.bit.2|真空2"
      }
    },
    {
      "id": "vio-main",
      "name": "虚拟 IO",
      "type": "vio",
      "driverId": "drv-vio",
      "enabled": true,
      "parameters": {
        "vio.b1": "virtual|vio.b1",
        "vio.b2": "virtual|vio.b2"
      }
    }
  ],
  "axes": [
    {
      "id": "AxisTransY",
      "name": "上下料Y轴",
      "type": "axis",
      "driverId": "drv-m1",
      "enabled": true,
      "parameters": {
        "axis": "0",
        "model": "Servo_2L_1O",
        "homeVel": "10.00",
        "pulsePerUnit": "10000",
        "maxVel": "150.00",
        "accel": "2000.00",
        "negLimit": "1",
        "posLimit": "1",
        "homeSensor": "0",
        "note": "上下料Y轴"
      }
    },
    {
      "id": "AxisX",
      "name": "检测X轴",
      "type": "axis",
      "driverId": "drv-m1",
      "enabled": true,
      "parameters": {
        "axis": "1",
        "model": "Servo_2L_1O",
        "homeVel": "10.00",
        "pulsePerUnit": "10000",
        "maxVel": "150.00",
        "accel": "2000.00",
        "negLimit": "1",
        "posLimit": "1",
        "homeSensor": "0",
        "note": "检测X轴"
      }
    },
    {
      "id": "AxisZ",
      "name": "检测Z轴",
      "type": "axis",
      "driverId": "drv-m1",
      "enabled": true,
      "parameters": {
        "axis": "2",
        "model": "Servo_2L_1O",
        "homeVel": "12.00",
        "pulsePerUnit": "10000",
        "maxVel": "50.00",
        "accel": "2000.00",
        "negLimit": "0",
        "posLimit": "1",
        "homeSensor": "0",
        "note": "检测Z轴"
      }
    }
  ],
  "platforms": [
    {
      "id": "plat-trans",
      "name": "上下料平台",
      "type": "x",
      "enabled": true,
      "parameters": {
        "axis.X": "AxisTransY",
        "note": "组合轴 AxisTransY"
      }
    },
    {
      "id": "plat-measure",
      "name": "检测平台",
      "type": "xy",
      "enabled": true,
      "parameters": {
        "axis.X": "AxisX",
        "axis.Y": "AxisZ",
        "note": "组合轴 AxisX + AxisZ"
      }
    }
  ],
  "tasks": [
    {
      "name": "task-operation",
      "type": "operation",
      "intervalMs": 200,
      "parameters": {}
    },
    {
      "name": "poll-m1",
      "type": "pollDriver",
      "driverId": "drv-m1",
      "intervalMs": 500,
      "parameters": {}
    },
    {
      "name": "poll-io1",
      "type": "pollDriver",
      "driverId": "drv-io1",
      "intervalMs": 500,
      "parameters": {}
    }
  ],
  "recipeVarKeys": [
    "machine.mode",
    "task.operation.command"
  ],
  "activeRecipeId": "default",
  "recipes": [
    {
      "id": "default",
      "name": "默认配方",
      "description": "自动运行",
      "vars": {
        "machine.mode": "AUTO",
        "task.operation.command": "IDLE"
      }
    }
  ],
  "vars": {
    "machine.mode": "AUTO",
    "task.operation.command": "IDLE"
  }
}
