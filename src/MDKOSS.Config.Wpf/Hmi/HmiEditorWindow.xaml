<Window x:Class="MDKOSS.Config.Wpf.Hmi.HmiEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HMI 主界面组态"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="960"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="8">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="删除选中" Click="Delete_Click"/>
        <Button Content="恢复默认" Click="Reset_Click"/>
        <Button Content="应用到工作区" Click="Apply_Click"
                Background="{StaticResource AccentBrush}" Foreground="White" Padding="12,4"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="标题" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"/>
        <TextBox x:Name="TitleBox" Width="200" TextChanged="CanvasMeta_Changed"/>
        <TextBlock Text="宽" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="WidthBox" Width="64" TextChanged="CanvasMeta_Changed"/>
        <TextBlock Text="高" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="HeightBox" Width="64" TextChanged="CanvasMeta_Changed"/>
        <TextBlock x:Name="HintText" Margin="16,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource MutedBrush}"
                   Text="左侧添加控件，画布拖动定位；应用到工作区后随 setting 一起保存。"/>
      </StackPanel>
    </DockPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="280"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="控件" FontWeight="SemiBold"
                     Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PalettePanel"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="6">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Canvas x:Name="Board"
                  Background="#EEF2F6"
                  ClipToBounds="True"
                  MouseLeftButtonDown="Board_MouseLeftButtonDown"
                  MouseMove="Board_MouseMove"
                  MouseLeftButtonUp="Board_MouseLeftButtonUp"/>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
              BorderThickness="1" CornerRadius="4" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="属性" FontWeight="SemiBold"
                     Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PropsPanel">
              <TextBlock Text="点选画布中的控件。" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
