<Window x:Class="MDKOSS.Config.Wpf.RecipePickVarsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从 Vars / SysConfig 选择配方键"
        Height="520" Width="640"
        MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="全选可见" Padding="10,4" Margin="0,0,8,0" Click="SelectVisible_Click"
              ToolTip="勾选当前筛选结果中的全部项"/>
      <Button Content="清除勾选" Padding="10,4" Margin="0,0,16,0" Click="ClearSelection_Click"/>
      <Button Content="确定" Width="88" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"
              Background="{StaticResource AccentBrush}" Foreground="White"/>
      <Button Content="取消" Width="88" IsCancel="True" Click="Cancel_Click"/>
    </StackPanel>

    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6"
                   Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                   Text="从 Vars 与 SysConfig.recipeVarKeys 查询并勾选要写入当前配方的键"/>
        <TextBlock Margin="0,0,0,8" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"
                   Text="已存在的键会保留配方里的当前值；新键用 Vars 现值填充（无则留空）。"/>
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="筛选" VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
          <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged"
                   ToolTip="按键名 / 来源 / 值过滤"/>
        </DockPanel>
      </StackPanel>

      <ListView x:Name="CandidateList"
                BorderBrush="{StaticResource BorderBrushKey}"
                BorderThickness="1"
                SelectionMode="Extended">
        <ListView.View>
          <GridView>
            <GridViewColumn Width="36">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Key" Width="200" DisplayMemberBinding="{Binding Key}"/>
            <GridViewColumn Header="来源" Width="140" DisplayMemberBinding="{Binding Source}"/>
            <GridViewColumn Header="Vars 当前值" Width="200" DisplayMemberBinding="{Binding ValuePreview}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </DockPanel>
  </DockPanel>
</Window>
