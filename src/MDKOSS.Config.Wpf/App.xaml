<Application x:Class="MDKOSS.Config.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MDKOSS.Config.Wpf">
  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#F4F6F8"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrushKey" Color="#D0D7DE"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0B6E4F"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E6F4EF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1F2328"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#656D76"/>
    <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <local:InvertBoolConverter x:Key="InvertBoolConverter"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushKey}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushKey}"/>
    </Style>
  </Application.Resources>
</Application>
