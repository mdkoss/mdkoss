<Window x:Class="MDKOSS.Config.Wpf.ComponentEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建组件"
        Height="560" Width="560"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="确定" Width="88" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"
              Background="{StaticResource AccentBrush}" Foreground="White"/>
      <Button Content="取消" Width="88" IsCancel="True" Click="Cancel_Click"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="HeadlineText" FontWeight="SemiBold" Margin="0,0,0,12"
                   Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>

        <StackPanel x:Name="IdPanel" Margin="0,0,0,8">
          <TextBlock Text="Name (Id)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
          <TextBox x:Name="IdBox"/>
        </StackPanel>
        <StackPanel x:Name="NamePanel" Margin="0,0,0,8" Visibility="Collapsed">
          <TextBlock Text="Desc (描述)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
          <TextBox x:Name="NameBox"/>
        </StackPanel>
        <StackPanel x:Name="TypePanel" Margin="0,0,0,8" Visibility="Collapsed">
          <TextBlock Text="Type" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
          <ComboBox x:Name="TypeCombo" IsEditable="True"
                    SelectionChanged="TypeCombo_SelectionChanged"
                    LostFocus="TypeCombo_LostFocus"/>
        </StackPanel>
        <StackPanel x:Name="DriverPanel" Margin="0,0,0,8" Visibility="Collapsed">
          <TextBlock Text="DriverId" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
          <ComboBox x:Name="DriverCombo" IsEditable="True"/>
        </StackPanel>
        <StackPanel x:Name="IntervalPanel" Margin="0,0,0,8" Visibility="Collapsed">
          <TextBlock Text="IntervalMs" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
          <TextBox x:Name="IntervalBox" Text="100"/>
        </StackPanel>
        <StackPanel x:Name="DescriptionPanel" Margin="0,0,0,8" Visibility="Collapsed">
          <TextBlock Text="Description" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
          <TextBox x:Name="DescriptionBox" AcceptsReturn="True" Height="48" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel x:Name="ValuePanel" Margin="0,0,0,8" Visibility="Collapsed">
          <TextBlock Text="Value" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
          <TextBox x:Name="ValueBox"/>
        </StackPanel>
        <StackPanel x:Name="EnabledPanel" Margin="0,0,0,8" Visibility="Collapsed" Orientation="Horizontal">
          <CheckBox x:Name="EnabledCheck" Content="Enabled" IsChecked="True"/>
        </StackPanel>

        <StackPanel x:Name="ParamsPanel" Margin="0,8,0,0" Visibility="Collapsed">
          <DockPanel Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="PickVarsButton" Content="从 Vars…" Padding="8,2" Margin="0,0,4,0"
                      Click="PickVars_Click" Visibility="Collapsed"
                      ToolTip="从全部 Vars 与全部 SysConfig 配置参数中勾选写入配方"/>
              <Button x:Name="PushAllVarsButton" Content="推送所有" Padding="8,2" Margin="0,0,4,0"
                      Click="PushAllVars_Click" Visibility="Collapsed"
                      ToolTip="一键把全部 Vars / SysConfig 候选键写入当前配方（已有键保留原值）"/>
              <Button Content="按类型填充" Padding="8,2" Margin="0,0,4,0" Click="FillTypeParams_Click"
                      ToolTip="按当前 Type 重置 Parameters 模板"/>
              <Button Content="+ 行" Padding="8,2" Margin="0,0,4,0" Click="AddParamRow_Click"/>
              <Button Content="删行" Padding="8,2" Click="RemoveParamRow_Click"/>
            </StackPanel>
            <TextBlock Text="Parameters (Key / Value)" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
          </DockPanel>
          <DataGrid x:Name="ParamGrid"
                    AutoGenerateColumns="False"
                    CanUserAddRows="True"
                    CanUserDeleteRows="True"
                    HeadersVisibility="Column"
                    Height="180"
                    BorderBrush="{StaticResource BorderBrushKey}"
                    BorderThickness="1">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
              <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
