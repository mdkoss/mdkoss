<UserControl x:Class="MDKOSS.UI.WPF.Views.Tools.Monitor.MonitorRuntimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource ToolBgBrush}">
  <DockPanel Margin="20,12">
    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource ToolStatusStyle}" Text="{Binding Status}"/>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Content="整机调试 →" Command="{Binding GoToolCommand}" CommandParameter="debug_machine" Style="{StaticResource ToolLinkStyle}"/>
        <Button Content="报警 →" Command="{Binding GoToolCommand}" CommandParameter="monitor_alarm" Style="{StaticResource ToolLinkStyle}"/>
      </StackPanel>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="运行总览" Style="{StaticResource ToolTitleStyle}"/>
          <Border Style="{StaticResource ToolPillStyle}"><TextBlock Text="只读" Style="{StaticResource ToolPillTextStyle}"/></Border>
        </StackPanel>
        <TextBlock Text="组件态势矩阵 · 自动刷新 1s" Style="{StaticResource ToolSubStyle}"/>
      </StackPanel>
    </DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource ToolNoteStyle}">
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ToolMutedBrush}" FontSize="12">
        本页只读。启停 / 复位请使用
        <Hyperlink Command="{Binding GoToolCommand}" CommandParameter="debug_machine" Foreground="{DynamicResource ToolAccentBrush}" FontWeight="Bold">整机调试</Hyperlink>
        ；切换配方请使用
        <Hyperlink Command="{Binding GoToolCommand}" CommandParameter="man_recipe" Foreground="{DynamicResource ToolAccentBrush}" FontWeight="Bold">配方配置</Hyperlink>
        或主界面。
      </TextBlock>
    </Border>
    <UniformGrid DockPanel.Dock="Top" Columns="5" Margin="0,0,0,12">
      <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="项目" Style="{StaticResource KpiLabelStyle}"/>
          <TextBlock Text="{Binding ProjectName}" Style="{StaticResource KpiValueStyle}" FontSize="16"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="运行状态" Style="{StaticResource KpiLabelStyle}"/>
          <TextBlock Text="{Binding RuntimeStatus}" Style="{StaticResource KpiValueStyle}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="驱动在线" Style="{StaticResource KpiLabelStyle}"/>
          <TextBlock Text="{Binding DriverOnline}" Style="{StaticResource KpiValueStyle}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="设备在线" Style="{StaticResource KpiLabelStyle}"/>
          <TextBlock Text="{Binding DeviceOnline}" Style="{StaticResource KpiValueStyle}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource KpiCardStyle}">
        <StackPanel>
          <TextBlock Text="更新" Style="{StaticResource KpiLabelStyle}"/>
          <TextBlock Text="{Binding LastUpdate}" Style="{StaticResource KpiValueStyle}" FontSize="16"/>
        </StackPanel>
      </Border>
    </UniformGrid>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border Style="{StaticResource ToolCardStyle}" Grid.Row="0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="驱动状态矩阵" Style="{StaticResource ToolPanelTitleStyle}"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Drivers}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="6"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,8,8" Padding="10,12" CornerRadius="4" BorderThickness="1"
                          BorderBrush="{DynamicResource ToolLineBrush}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ToolMatrixOffBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Mode}" Value="ok">
                            <Setter Property="Background" Value="{DynamicResource ToolMatrixOkBrush}"/>
                            <Setter Property="BorderBrush" Value="#592DB87C"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Mode}" Value="bad">
                            <Setter Property="Background" Value="{DynamicResource ToolMatrixFaultBrush}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Mode}" Value="warn">
                            <Setter Property="Background" Value="{DynamicResource ToolMatrixWarnBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource ToolTextBrush}"/>
                      <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource ToolMutedBrush}"/>
                      <TextBlock Text="{Binding Mode}" FontSize="12" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource ToolTextBrush}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource ToolCardStyle}" Grid.Row="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="设备状态矩阵" Style="{StaticResource ToolPanelTitleStyle}"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Devices}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="6"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,8,8" Padding="10,12" CornerRadius="4" BorderThickness="1">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ToolMatrixOffBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ToolLineBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Mode}" Value="ok">
                            <Setter Property="Background" Value="{DynamicResource ToolMatrixOkBrush}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Mode}" Value="warn">
                            <Setter Property="Background" Value="{DynamicResource ToolMatrixWarnBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ToolTextBrush}"/>
                      <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource ToolMutedBrush}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource ToolCardStyle}" Grid.Row="2" Margin="0">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="任务明细 →" Command="{Binding GoToolCommand}" CommandParameter="monitor_task" Style="{StaticResource ToolLinkStyle}"/>
            <TextBlock Text="任务 / 灯色" Style="{StaticResource ToolPanelTitleStyle}" Margin="0"/>
          </DockPanel>
          <DockPanel Margin="0,0,0,6">
            <TextBlock Text="操作状态" Foreground="{DynamicResource ToolMutedBrush}" FontSize="12"/>
            <TextBlock Text="{Binding OpState}" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{DynamicResource ToolMonoBrush}"/>
          </DockPanel>
          <DockPanel Margin="0,0,0,6">
            <TextBlock Text="说明" Foreground="{DynamicResource ToolMutedBrush}" FontSize="12"/>
            <TextBlock Text="{Binding OpMsg}" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{DynamicResource ToolMonoBrush}"/>
          </DockPanel>
          <DockPanel Margin="0,0,0,6">
            <TextBlock Text="三色灯" Foreground="{DynamicResource ToolMutedBrush}" FontSize="12"/>
            <TextBlock Text="{Binding OpLamp}" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{DynamicResource ToolMonoBrush}"/>
          </DockPanel>
          <DockPanel>
            <TextBlock Text="当前配方" Foreground="{DynamicResource ToolMutedBrush}" FontSize="12"/>
            <TextBlock Text="{Binding Recipe}" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{DynamicResource ToolMonoBrush}"/>
          </DockPanel>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
