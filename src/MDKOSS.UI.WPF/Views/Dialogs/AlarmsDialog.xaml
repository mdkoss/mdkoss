<UserControl x:Class="MDKOSS.UI.WPF.Views.Dialogs.AlarmsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="测试触发" Command="{Binding TriggerCommand}" Style="{StaticResource DialogButtonStyle}"/>
        <Button Content="全部复位" Command="{Binding ClearCommand}" Style="{StaticResource DialogButtonStyle}"/>
        <Button Content="关闭" Command="{Binding CloseCommand}" Style="{StaticResource DialogButtonStyle}"/>
      </StackPanel>
      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
    </DockPanel>
    <DataGrid ItemsSource="{Binding Items}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="0.8*"/>
        <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="0.7*"/>
        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1*"/>
        <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="0.6*"/>
        <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="1.6*"/>
        <DataGridTextColumn Header="时间" Binding="{Binding TriggerTime}" Width="1*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
