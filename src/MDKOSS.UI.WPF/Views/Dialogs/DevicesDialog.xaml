<UserControl x:Class="MDKOSS.UI.WPF.Views.Dialogs.DevicesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="关闭" Command="{Binding CloseCommand}" Style="{StaticResource DialogButtonStyle}"/>
      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
    </DockPanel>
    <DataGrid ItemsSource="{Binding Items}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="1*"/>
        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.2*"/>
        <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="0.8*"/>
        <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="0.8*"/>
        <DataGridTextColumn Header="驱动" Binding="{Binding Driver}" Width="0.8*"/>
        <DataGridTextColumn Header="在线" Binding="{Binding Online}" Width="0.6*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
