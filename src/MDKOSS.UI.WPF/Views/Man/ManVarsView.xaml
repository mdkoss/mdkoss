<UserControl x:Class="MDKOSS.UI.WPF.Views.Tools.Man.ManVarsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource ToolBgBrush}">
  <DockPanel Margin="20,12">
    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource ToolStatusStyle}" Text="{Binding Status}"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="变量配置" Style="{StaticResource ToolTitleStyle}"/>
          <Border Style="{StaticResource ToolPillStyle}"><TextBlock Text="配置" Style="{StaticResource ToolPillTextStyle}"/></Border>
        </StackPanel>
        <TextBlock Text="种子变量 Key / Value" Style="{StaticResource ToolSubStyle}"/>
      </StackPanel>
    </DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource ToolNoteStyle}">
      <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="{DynamicResource ToolMutedBrush}"/>
    </Border>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="新建" Command="{Binding AddCommand}" Style="{StaticResource ToolBtnStyle}"
                Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}"/>
        <Button Content="复制" Command="{Binding DuplicateCommand}" Style="{StaticResource ToolBtnStyle}"
                Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}"/>
        <Button Content="删除" Command="{Binding DeleteCommand}" Style="{StaticResource ToolBtnDangerStyle}"
                Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}"/>
        <Button Content="应用属�? Command="{Binding ApplyCommand}" Style="{StaticResource ToolBtnPrimaryStyle}"/>
        <Button Content="保存到磁�? Command="{Binding SaveCommand}" Style="{StaticResource ToolBtnStyle}"/>
      </StackPanel>
      <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left"/>
    </DockPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*"/>
        <ColumnDefinition Width="1.2*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource ToolCardStyle}" Grid.Column="0" Margin="0,0,8,0">
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="*"/>
            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80"/>
            <DataGridTextColumn Header="说明" Binding="{Binding Desc}" Width="*"/>
            <DataGridTextColumn Header="状�? Binding="{Binding Extra}" Width="80"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <Border Style="{StaticResource ToolCardStyle}" Grid.Column="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="属�? FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,6" Visibility="{Binding ShowId, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding IdLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ToolMutedBrush}"/>
              <TextBox Grid.Column="1" Text="{Binding EditId, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,6" Visibility="{Binding ShowName, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding NameLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ToolMutedBrush}"/>
              <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,6" Visibility="{Binding ShowType, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Type" VerticalAlignment="Center" Foreground="{DynamicResource ToolMutedBrush}"/>
              <TextBox Grid.Column="1" Text="{Binding EditType, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,6" Visibility="{Binding ShowDriver, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="DriverId" VerticalAlignment="Center" Foreground="{DynamicResource ToolMutedBrush}"/>
              <TextBox Grid.Column="1" Text="{Binding EditDriverId, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,6" Visibility="{Binding ShowCamera, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="默认相机" VerticalAlignment="Center" Foreground="{DynamicResource ToolMutedBrush}"/>
              <TextBox Grid.Column="1" Text="{Binding EditCamera, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,6" Visibility="{Binding ShowInterval, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="IntervalMs" VerticalAlignment="Center" Foreground="{DynamicResource ToolMutedBrush}"/>
              <TextBox Grid.Column="1" Text="{Binding EditInterval, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,6" Visibility="{Binding ShowCode, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Code" VerticalAlignment="Center" Foreground="{DynamicResource ToolMutedBrush}"/>
              <TextBox Grid.Column="1" Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,6" Visibility="{Binding ShowLevel, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="级别" VerticalAlignment="Center" Foreground="{DynamicResource ToolMutedBrush}"/>
              <TextBox Grid.Column="1" Text="{Binding EditLevel, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,6" Visibility="{Binding ShowOp, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="比较" VerticalAlignment="Center" Foreground="{DynamicResource ToolMutedBrush}"/>
              <TextBox Grid.Column="1" Text="{Binding EditOp, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,6" Visibility="{Binding ShowVarKey, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="变量�? VerticalAlignment="Center" Foreground="{DynamicResource ToolMutedBrush}"/>
              <TextBox Grid.Column="1" Text="{Binding EditVarKey, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,6" Visibility="{Binding ShowValue, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Value" VerticalAlignment="Center" Foreground="{DynamicResource ToolMutedBrush}"/>
              <TextBox Grid.Column="1" Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Grid Margin="0,0,0,6" Visibility="{Binding ShowDesc, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="说明 / 消息" VerticalAlignment="Center" Foreground="{DynamicResource ToolMutedBrush}"/>
              <TextBox Grid.Column="1" Text="{Binding EditDesc, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <CheckBox Content="Enabled" IsChecked="{Binding EditEnabled}" Margin="0,4,0,6"
                      Visibility="{Binding ShowEnabled, Converter={StaticResource BoolToVis}}"/>
            <CheckBox Content="锁存" IsChecked="{Binding EditLatch}" Margin="0,0,0,8"
                      Visibility="{Binding ShowLatch, Converter={StaticResource BoolToVis}}"/>
            <DockPanel Visibility="{Binding ShowParams, Converter={StaticResource BoolToVis}}">
              <DockPanel DockPanel.Dock="Top" Margin="0,8,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="+ �? Command="{Binding AddParamCommand}" Style="{StaticResource ToolBtnStyle}"/>
                  <Button Content="删行" Command="{Binding RemoveParamCommand}" Style="{StaticResource ToolBtnStyle}"/>
                </StackPanel>
                <TextBlock Text="{Binding ParamTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <DataGrid ItemsSource="{Binding Parameters}" IsReadOnly="False" Height="220">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                  <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
