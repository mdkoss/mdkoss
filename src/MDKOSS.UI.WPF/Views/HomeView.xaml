<UserControl x:Class="MDKOSS.UI.WPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="Transparent">
  <DockPanel Margin="20,16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="{Binding OrderListMeta}" DockPanel.Dock="Right"
                 Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
      <TextBlock Text="订单列表" FontSize="20" FontWeight="Bold"/>
    </DockPanel>

    <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
      <DataGrid ItemsSource="{Binding Orders}"
                SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                MouseDoubleClick="OnOrderDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="订单号" Binding="{Binding Id}" Width="1.4*"/>
          <DataGridTextColumn Header="产品" Binding="{Binding Product}" Width="1.4*"/>
          <DataGridTextColumn Header="数量" Binding="{Binding Qty}" Width="0.6*"/>
          <DataGridTemplateColumn Header="状态" Width="0.8*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Background="{Binding Status, Converter={StaticResource OrderStatusBrush}}"
                        CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding StatusLabel}"/>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="进度" Binding="{Binding ProgressText}" Width="0.6*"/>
          <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="1.4*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
