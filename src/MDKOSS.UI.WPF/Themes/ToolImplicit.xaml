<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource ToolInputBgBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource ToolTextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ToolLineBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource ToolAccentBrush}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource ToolInputBgBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource ToolTextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ToolLineBrush}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="MinHeight" Value="32"/>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource ToolTextBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource ToolInputBgBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource ToolTextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ToolLineBrush}"/>
    <Setter Property="RowBackground" Value="{DynamicResource ToolInputBgBrush}"/>
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource ToolPanel2Brush}"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ToolLineBrush}"/>
    <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="RowHeaderWidth" Value="0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource ToolTableHeadBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource ToolMutedBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ToolLineBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource ToolTextBrush}"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource ToolAccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ToolTextBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource ToolTextBrush}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource ToolAccentSoftBrush}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource ToolAccentSoftBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
