{
  "projectName": "检测上下料机",
  "cycleMs": 20,
  "monitoringPrefix": "http://127.0.0.1:5080/",
  "startPage": "index.html",
  "drivers": [
    {
      "id": "drv-m1",
      "type": "sim",
      "enabled": true,
      "parameters": {
        "ip": "127.0.0.1",
        "port": "5000",
        "card": "0",
        "model": "VirtualCard",
        "note": "M1 运动卡 VirtualCard"
      }
    },
    {
      "id": "drv-io1",
      "type": "sim",
      "enabled": true,
      "parameters": {
        "ip": "127.0.0.1",
        "port": "5001",
        "card": "0",
        "model": "VirtualCard",
        "note": "IO1 IO 卡 VirtualCard"
      }
    },
    {
      "id": "drv-vio",
      "type": "sim",
      "enabled": true,
      "parameters": {
        "ip": "127.0.0.1",
        "port": "5002",
        "card": "0",
        "model": "VirtualCard",
        "note": "VIO 虚拟卡 VirtualCard"
      }
    }
  ],
  "devices": [
    {
      "id": "gpio-m1",
      "name": "M1 IO",
      "type": "gpio",
      "driverId": "drv-m1",
      "enabled": true,
      "parameters": {
        "in.DiEstopButton": "0|急停",
        "in.DiStartButton": "1|启动按钮",
        "in.DiStopButton": "2|停止按钮",
        "in.DiResetButton": "3|复位按钮",
        "in.DiSafeDoor1Button": "4|安全门1",
        "in.DiSafeDoor2Button": "5|安全门2",
        "in.DiSafeDoor3Button": "6|安全门3",
        "in.DiSafeDoor4Button": "7|安全门4",
        "in.DiSafeDoor5Button": "8|安全门5",
        "in.DiFrontCy0": "10|前定位气缸原点",
        "in.DiFrontCy1": "11|前定位气缸动点",
        "in.DiBackCy0": "12|后定位气缸原点",
        "in.DiBackCy1": "13|后定位气缸动点",
        "out.DOButtonGreen": "0|启动按钮灯",
        "out.DOButtonRed": "1|停止按钮灯",
        "out.DOButtonYellow": "2|复位按钮灯",
        "out.DOLightGreen": "3|绿灯",
        "out.DOLightYellow": "4|黄灯",
        "out.DOLightRed": "5|红灯",
        "out.DOBuzzer": "6|蜂鸣器",
        "out.DOFrontCy": "8|前定位气缸动作",
        "out.DOBackCy": "9|后定位气缸动作",
        "out.DOLeftCy": "10|左定位气缸动作",
        "out.DORightCy": "11|右定位气缸动作"
      }
    },
    {
      "id": "gpio-io1",
      "name": "IO1 IO",
      "type": "gpio",
      "driverId": "drv-io1",
      "enabled": true,
      "parameters": {
        "in.DiLeftCy0": "0|lcy0",
        "in.DiLeftCy1": "1|lcy1",
        "in.DiRightCy0": "2|rcy0",
        "in.DiRightCy1": "3|rcy1",
        "in.DiSensor1": "4|sensor1",
        "in.DiSensor2": "5|sensor2",
        "in.DiSensor3": "6|sensor3",
        "in.DiSafeCurtain": "7|sc",
        "in.DiAirPressure": "8|ap",
        "in.DiStart1": "9|Start1",
        "in.DiStart2": "10|Start2",
        "in.DiVaccum1": "11|Vaccum1",
        "in.DiVaccum2": "12|Vaccum2",
        "out.DOLamp": "0|灯",
        "out.DOVaccum1": "1|真空1",
        "out.DOVaccum2": "2|真空2"
      }
    },
    {
      "id": "vio-main",
      "name": "虚拟 IO",
      "type": "vio",
      "driverId": "drv-vio",
      "enabled": true,
      "parameters": {
        "in.TestVio": "virtual|TestVio",
        "out.TestVio": "virtual|TestVio"
      }
    },
    {
      "id": "AxisTransY",
      "name": "上下料Y轴",
      "type": "axis",
      "driverId": "drv-m1",
      "enabled": true,
      "parameters": {
        "axis": "0",
        "model": "Servo_2L_1O",
        "homeVel": "10.00",
        "pulsePerUnit": "10000",
        "maxVel": "150.00",
        "accel": "2000.00",
        "negLimit": "1",
        "posLimit": "1",
        "homeSensor": "0",
        "note": "上下料Y轴"
      }
    },
    {
      "id": "AxisX",
      "name": "检测X轴",
      "type": "axis",
      "driverId": "drv-m1",
      "enabled": true,
      "parameters": {
        "axis": "1",
        "model": "Servo_2L_1O",
        "homeVel": "10.00",
        "pulsePerUnit": "10000",
        "maxVel": "150.00",
        "accel": "2000.00",
        "negLimit": "1",
        "posLimit": "1",
        "homeSensor": "0",
        "note": "检测X轴"
      }
    },
    {
      "id": "AxisZ",
      "name": "检测Z轴",
      "type": "axis",
      "driverId": "drv-m1",
      "enabled": true,
      "parameters": {
        "axis": "2",
        "model": "Servo_2L_1O",
        "homeVel": "12.00",
        "pulsePerUnit": "10000",
        "maxVel": "50.00",
        "accel": "2000.00",
        "negLimit": "0",
        "posLimit": "1",
        "homeSensor": "0",
        "note": "检测Z轴"
      }
    },
    {
      "id": "plat-trans",
      "name": "上下料平台",
      "type": "x",
      "driverId": "drv-m1",
      "enabled": true,
      "parameters": {
        "kind": "x",
        "model": "PlatformXyz",
        "axis.X": "drv-m1",
        "axisIndex.X": "0",
        "note": "Trans / AxisTransY"
      }
    },
    {
      "id": "plat-measure",
      "name": "检测平台",
      "type": "xy",
      "driverId": "drv-m1",
      "enabled": true,
      "parameters": {
        "kind": "xy",
        "model": "PlatformXyz",
        "axis.X": "drv-m1",
        "axisIndex.X": "1",
        "axis.Y": "drv-m1",
        "axisIndex.Y": "2",
        "note": "Measure / AxisX+AxisZ"
      }
    }
  ],
  "tasks": [
    {
      "name": "task-operation",
      "type": "operation",
      "intervalMs": 200,
      "parameters": {
        "gpioDeviceId": "gpio-m1"
      }
    },
    {
      "name": "poll-m1",
      "type": "pollDriver",
      "driverId": "drv-m1",
      "intervalMs": 500,
      "parameters": {}
    },
    {
      "name": "poll-io1",
      "type": "pollDriver",
      "driverId": "drv-io1",
      "intervalMs": 500,
      "parameters": {}
    }
  ],
  "recipeVarKeys": [
    "machine.mode",
    "task.operation.command"
  ],
  "activeRecipeId": "default",
  "recipes": [
    {
      "id": "default",
      "name": "默认配方",
      "description": "自动运行",
      "vars": {
        "machine.mode": "AUTO",
        "task.operation.command": "IDLE"
      }
    }
  ],
  "vars": {
    "machine.mode": "AUTO",
    "task.operation.command": "IDLE"
  }
}
