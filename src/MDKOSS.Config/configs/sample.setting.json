{
  "projectName": "MDKOSS-Demo",
  "cycleMs": 20,
  "drivers": [
    {
      "id": "drv-main",
      "type": "sim",
      "enabled": true,
      "parameters": {
        "ip": "127.0.0.1",
        "port": "5000"
      }
    },
    {
      "id": "drv-gpio-aux",
      "type": "sim",
      "enabled": true,
      "parameters": {
        "ip": "127.0.0.1",
        "port": "5001"
      }
    },
    {
      "id": "drv-gpio-io2",
      "type": "sim",
      "enabled": true,
      "parameters": {
        "ip": "127.0.0.1",
        "port": "5002"
      }
    }
  ],
  "devices": [
    {
      "id": "gpio-main",
      "name": "GPIO Main",
      "type": "gpio",
      "enabled": true,
      "parameters": {
        "driverIds": "drv-main,drv-gpio-aux,drv-gpio-io2",
        "in.startButton": "drv-main:X0",
        "in.stopButton": "drv-gpio-aux:X1",
        "in.resetButton": "drv-gpio-io2:X2",
        "in.safetyDoor": "drv-gpio-io2:X3",
        "out.tower.red": "drv-main:Y0",
        "out.tower.yellow": "drv-gpio-aux:Y1",
        "out.tower.green": "drv-main:Y2",
        "out.buzzer": "drv-gpio-io2:Y3"
      }
    },
    {
      "id": "vio-sim",
      "name": "Virtual GPIO (SIM)",
      "type": "vio",
      "driverId": "drv-main",
      "enabled": true,
      "parameters": {
        "in.vtest.di": "virtual",
        "out.vtest.do": ""
      }
    },
    {
      "id": "dev-axis",
      "name": "Sample Axis",
      "type": "axis",
      "driverId": "drv-main",
      "enabled": true,
      "parameters": {}
    },
    {
      "id": "dev-cameradev",
      "name": "Sample Camera",
      "type": "cameradev",
      "driverId": "drv-main",
      "enabled": true,
      "parameters": {}
    },
    {
      "id": "dev-extcamera",
      "name": "Sample Ext Camera",
      "type": "extcamera",
      "enabled": false,
      "parameters": {
        "backend": "sim",
        "deviceIndex": "0",
        "width": "1280",
        "height": "720",
        "exposureMs": "10",
        "noisePx": "0.5"
      }
    },
    {
      "id": "dev-platform-kind-xy",
      "name": "Platform kind=xy",
      "type": "platform",
      "driverId": "drv-main",
      "enabled": true,
      "parameters": {
        "kind": "xy"
      }
    },
    {
      "id": "dev-platform-kind-xyz",
      "name": "Platform kind=xyz",
      "type": "platform",
      "driverId": "drv-main",
      "enabled": true,
      "parameters": {
        "kind": "xyz"
      }
    },
    {
      "id": "dev-platform-kind-xyzu",
      "name": "Platform kind=xyzu",
      "type": "platform",
      "driverId": "drv-main",
      "enabled": true,
      "parameters": {
        "kind": "xyzu"
      }
    },
    {
      "id": "dev-platform-kind-xyzuv",
      "name": "Platform kind=xyzuv",
      "type": "platform",
      "driverId": "drv-main",
      "enabled": true,
      "parameters": {
        "kind": "xyzuv"
      }
    },
    {
      "id": "dev-platform-kind-xyzuvw",
      "name": "Platform kind=xyzuvw",
      "type": "platform",
      "driverId": "drv-main",
      "enabled": true,
      "parameters": {
        "kind": "xyzuvw"
      }
    },
    {
      "id": "dev-type-xy",
      "name": "Shorthand type xy",
      "type": "xy",
      "driverId": "drv-main",
      "enabled": true,
      "parameters": {}
    },
    {
      "id": "dev-type-xyz",
      "name": "Shorthand type xyz",
      "type": "xyz",
      "driverId": "drv-main",
      "enabled": true,
      "parameters": {}
    },
    {
      "id": "dev-type-xyzu",
      "name": "Shorthand type xyzu",
      "type": "xyzu",
      "driverId": "drv-main",
      "enabled": true,
      "parameters": {}
    },
    {
      "id": "dev-type-xyzuv",
      "name": "Shorthand type xyzuv",
      "type": "xyzuv",
      "driverId": "drv-main",
      "enabled": true,
      "parameters": {}
    },
    {
      "id": "dev-type-xyzuvw",
      "name": "Shorthand type xyzuvw",
      "type": "xyzuvw",
      "driverId": "drv-main",
      "enabled": true,
      "parameters": {}
    },
    {
      "id": "dev-platform-per-axis",
      "name": "XYZ per-axis drivers",
      "type": "xyz",
      "driverId": "",
      "enabled": true,
      "parameters": {
        "axis.X": "drv-main",
        "axis.Y": "drv-gpio-aux",
        "axis.Z": "drv-gpio-io2"
      }
    }
  ],
  "tasks": [
    {
      "name": "task-operation",
      "type": "operation",
      "intervalMs": 200,
      "parameters": {}
    },
    {
      "name": "task-cycle",
      "type": "cycle",
      "intervalMs": 1000,
      "parameters": {}
    },
    {
      "name": "poll-main",
      "type": "pollDriver",
      "driverId": "drv-main",
      "intervalMs": 500,
      "parameters": {}
    },
    {
      "name": "poll-gpio-aux",
      "type": "pollDriver",
      "driverId": "drv-gpio-aux",
      "intervalMs": 500,
      "parameters": {}
    },
    {
      "name": "poll-gpio-io2",
      "type": "pollDriver",
      "driverId": "drv-gpio-io2",
      "intervalMs": 500,
      "parameters": {}
    },
    {
      "name": "task-flow-demo",
      "type": "flow",
      "intervalMs": 100,
      "parameters": {
        "loop": "true",
        "flowJson": "{\"version\":1,\"variables\":[{\"name\":\"x\",\"type\":\"number\",\"init\":\"0\"}],\"functions\":[{\"name\":\"main\",\"entryNodeId\":\"n-start\"}],\"nodes\":[{\"id\":\"n-start\",\"kind\":\"start\",\"x\":80,\"y\":120,\"props\":{}},{\"id\":\"n-set\",\"kind\":\"setVar\",\"x\":260,\"y\":120,\"props\":{\"name\":\"x\",\"expr\":\"x + 1\"}},{\"id\":\"n-log\",\"kind\":\"op.log\",\"x\":440,\"y\":120,\"props\":{\"message\":\"\\\"tick \\\" + x\"}},{\"id\":\"n-end\",\"kind\":\"end\",\"x\":620,\"y\":120,\"props\":{}}],\"edges\":[{\"from\":\"n-start\",\"to\":\"n-set\",\"port\":\"next\"},{\"from\":\"n-set\",\"to\":\"n-log\",\"port\":\"next\"},{\"from\":\"n-log\",\"to\":\"n-end\",\"port\":\"next\"}]}"
      }
    }
  ],
  "recipeVarKeys": [
    "machine.mode",
    "task.operation.command"
  ],
  "activeRecipeId": "default",
  "recipes": [
    {
      "id": "default",
      "name": "默认配方",
      "description": "自动运行，绿灯指示",
      "vars": {
        "machine.mode": "AUTO",
        "task.operation.command": "lamp:green"
      }
    },
    {
      "id": "manual",
      "name": "手动配方",
      "description": "手动模式，黄灯指示",
      "vars": {
        "machine.mode": "MANUAL",
        "task.operation.command": "lamp:yellow"
      }
    }
  ],
  "vars": {
    "machine.mode": "AUTO",
    "machine.ready": true,
    "task.operation.alias.red": "tower.red",
    "task.operation.alias.yellow": "tower.yellow",
    "task.operation.alias.green": "tower.green",
    "task.operation.command": "lamp:green"
  }
}
