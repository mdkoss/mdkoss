{
  "name": "extcamera-demo",
  "description": "Minimal project demonstrating MDKOSS.Extensions.Camera (extcamera)",
  "databasePath": "data/mdk.db",
  "monitoring": {
    "enabled": true,
    "url": "http://127.0.0.1:5080/"
  },
  "drivers": [
    {
      "id": "drv-sim",
      "name": "Sim Driver",
      "type": "sim",
      "enabled": true,
      "parameters": {}
    }
  ],
  "devices": [
    {
      "id": "cam-ext-1",
      "name": "Demo Ext Camera",
      "type": "extcamera",
      "enabled": true,
      "parameters": {
        "backend": "sim",
        "deviceIndex": "0",
        "width": "1280",
        "height": "720",
        "exposureUs": "12000",
        "noisePx": "0.8"
      }
    },
    {
      "id": "cam-hik-1",
      "name": "HikRobot Downlook",
      "type": "extcamera",
      "enabled": false,
      "parameters": {
        "backend": "hik",
        "deviceIndex": "0",
        "serialNumber": "",
        "width": "2448",
        "height": "2048",
        "exposureUs": "8000",
        "gain": "2",
        "triggerMode": "software",
        "pixelFormat": "BayerRG8",
        "timeoutMs": "2000",
        "saveDir": "data/captures",
        "fallbackToSim": "true"
      }
    },
    {
      "id": "cam-file-1",
      "name": "Offline Replay",
      "type": "extcamera",
      "enabled": false,
      "parameters": {
        "backend": "file",
        "sourcePath": "data/captures",
        "autoOpen": "true"
      }
    }
  ],
  "tasks": [
    {
      "id": "poll-main",
      "name": "Poll Driver",
      "type": "pollDriver",
      "enabled": true,
      "driverId": "drv-sim",
      "intervalMs": 200,
      "parameters": {}
    }
  ],
  "vars": {},
  "recipes": []
}
