<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MDKOSS.Cef.Sample</RootNamespace>
    <AssemblyName>MDKOSS.Cef.Sample</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <IncludeMdkPnpPlugin>false</IncludeMdkPnpPlugin>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NLog" Version="6.1.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MDKOSS.Core\MDKOSS.Core.csproj" />
    <ProjectReference Include="..\MDKOSS.Extensions\MDKOSS.Extensions.csproj" />
    <!-- Cef Content views/** 经 ProjectReference 复制到输出 views/，勿再 Link 一遍以免 views\views 嵌套 -->
    <ProjectReference Include="..\MDKOSS.Cef\MDKOSS.Cef.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="configs\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="..\MdkPlugins.targets" />
</Project>
