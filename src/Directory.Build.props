<Project>
  <PropertyGroup>
    <!-- Product release version for all src assemblies.
         GitHub Actions creates a Release when tag v$(Version) is pushed (see MdkProduct.ReleaseTag). -->
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
  </PropertyGroup>
</Project>
